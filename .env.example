# ============================================================================
# Lor Mentor — COMPLETE environment reference
# ----------------------------------------------------------------------------
# This file documents EVERY environment variable the code actually reads. It is
# the human-readable reference; the values below are LOCAL-DEVELOPMENT values and
# contain no real secrets.
#
# Which file do I use?
#   Local development ....... copy this file to `.env` (repo root) and to
#                             `apps/api/.env`, then set real local values.
#   Staging / production .... copy `.env.production.example` to `.env.production`
#                             on the VPS. It has the same keys as this file with
#                             production values; full documentation is here.
#   Receipt verifier only ... `services/receipt-verifier/.env.example`.
#
# Rules that never change:
#   * Never commit a filled `.env` / `.env.production` (both are git-ignored).
#   * Never put a secret under a `NEXT_PUBLIC_` name — anything with that prefix
#     is shipped to the browser.
#   * Staging and production use the SAME key set. Only the VALUES differ.
#
# Validate before deploying:
#   npm run check:env -- .env.production            # duplicates/structure
#   npm run check:env -- .env.production --strict   # placeholders/localhost
#
# The API additionally validates at boot (apps/api/src/config/env.validation.ts)
# and refuses to start on a bad production configuration.
# ============================================================================


# ── Application ─────────────────────────────────────────────────────────────
# NODE_ENV
#   Selects production behaviour: cookie `Secure` flag, required-secret checks,
#   localhost rejection. Required (defaults to development if unset).
#   Server-only. Source: set by you. Staging AND production: "production".
NODE_ENV=development

# PORT
#   TCP port the NestJS API listens on inside its container. Optional, default
#   4000. Server-only. Staging = production = 4000 (nginx proxies to it).
PORT=4000

# WEB_PUBLIC_URL
#   Public HTTPS origin of the Next.js web app. Used to build email links,
#   password-reset URLs and the Chapa return URL.
#   REQUIRED in production, must not be localhost. Server-only (the value is
#   public, but it is not injected into the browser bundle by this name).
#   Source: the domain you registered. Staging and production: different hosts.
WEB_PUBLIC_URL=http://localhost:3000

# API_PUBLIC_URL
#   Public HTTPS origin of the NestJS API. Used to build the Chapa callback URL
#   (`<API_PUBLIC_URL>/api/v1/payments/chapa/callback`).
#   REQUIRED in production, must not be localhost. Server-only.
#   Source: the domain you registered. Staging and production: different hosts.
API_PUBLIC_URL=http://localhost:4000

# APP_URL
#   Legacy fallback for email links when WEB_PUBLIC_URL is unset. Optional.
#   Keep it equal to WEB_PUBLIC_URL. Server-only.
APP_URL=http://localhost:3000

# COLLEGE_NAME
#   Display name printed on generated PDF receipts and transactional emails.
#   Optional (defaults to "Lorcan Medical College"). Server-only.
#   Source: the college. Staging and production: normally the same.
COLLEGE_NAME="Lorcan Medical College"

# APP_NAME
#   Product/brand name used in email subjects and receipt headers. Optional
#   (defaults to "Lor Mentor"). Server-only.
APP_NAME="Lor Mentor"


# ── CORS ────────────────────────────────────────────────────────────────────
# CORS_ORIGIN
#   Exact browser origin(s) allowed to call the API, comma-separated.
#   REQUIRED in production. Wildcards (`*`) are rejected at preflight AND at
#   API boot — CORS is credentialed, so a wildcard is never safe.
#   Server-only. Source: your web domain. Staging and production: different.
CORS_ORIGIN="http://localhost:3000"


# ── Reverse proxy / cookies ─────────────────────────────────────────────────
# TRUST_PROXY
#   Number of reverse-proxy hops Express trusts when reading X-Forwarded-For.
#   Optional. Blank = 1 in production, 0 elsewhere. Use 2 if Cloudflare sits in
#   front of nginx. Never use `true` (trusts every hop).
#   Server-only. Staging = production = blank (single nginx hop).
TRUST_PROXY=

# COOKIE_DOMAIN
#   Shared parent domain for the auth cookies (access_token / refresh_token).
#   REQUIRED whenever the web app and API are on different hostnames, which is
#   the documented production topology (lormentor.com + api.lormentor.com).
#   Without it the browser never sends the auth cookies to the web host and
#   every protected page redirects to /login (an unrecoverable login loop).
#   Format: bare parent domain with a leading dot. No scheme, port or wildcard.
#   You configure it server-side, but its effect is visible to the browser.
#   Staging and production: use each environment's own domain.
#   Leave blank ONLY for same-origin development.
COOKIE_DOMAIN=


# ── Database (PostgreSQL) ───────────────────────────────────────────────────
# DATABASE_URL
#   PostgreSQL connection string used by Prisma. REQUIRED in every environment.
#   Server-only — highest sensitivity (contains the DB password).
#   Source: constructed from your PostgreSQL credentials.
#   Local dev: localhost. Docker: host is the compose service name `postgres`.
#   Staging and production: different databases and different passwords.
#   NOTE: if the password contains @ : / # % ? it must be percent-encoded, or
#   the URI will be parsed incorrectly. Prefer `openssl rand -hex 24`.
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/lor_mentor"

# The three POSTGRES_* values below are read ONLY by the Docker Compose
# `postgres` service to initialise its data directory. For local development
# against an existing PostgreSQL install you can leave them blank.
#   Server-only. Source: chosen by you. Staging and production: different.

# POSTGRES_USER — superuser created in the container. Required for Docker deploys.
POSTGRES_USER=lor

# POSTGRES_PASSWORD
#   Required for Docker deploys. Must be URL-safe characters only (use
#   `openssl rand -hex 24`) and MUST be kept identical to the password embedded
#   in DATABASE_URL above. Staging and production: different values.
POSTGRES_PASSWORD=CHANGE_ME_URL_SAFE_hex_password

# POSTGRES_DB — database name created in the container. Required for Docker.
POSTGRES_DB=lor_mentor


# ── Authentication / JWT ────────────────────────────────────────────────────
# JWT_ACCESS_SECRET
#   HMAC key that signs short-lived access tokens. REQUIRED in every
#   environment. Server-only — the single most sensitive value here: anyone who
#   knows it can forge an admin session.
#   Source: `openssl rand -hex 48`. Must be >= 32 chars and differ from the
#   refresh secret. Staging and production: DIFFERENT values (mandatory).
JWT_ACCESS_SECRET=change-me-to-a-long-random-string

# JWT_REFRESH_SECRET
#   HMAC key that signs refresh tokens (7-day sessions). REQUIRED.
#   Server-only. Source: a second, different `openssl rand -hex 48`.
#   Staging and production: DIFFERENT values.
JWT_REFRESH_SECRET=change-me-to-another-long-random-string

# JWT_ACCESS_EXPIRES_IN — access-token lifetime. Optional, default `15m`.
#   Server-only. Staging = production.
JWT_ACCESS_EXPIRES_IN=15m

# JWT_REFRESH_EXPIRES_IN — refresh-token lifetime. Optional, default `7d`.
#   Shorter means more re-logins; changing it affects active sessions.
#   Server-only. Staging = production.
JWT_REFRESH_EXPIRES_IN=7d


# ── Email (SMTP — Resend by default) ───────────────────────────────────────
# Email is REQUIRED in production: password reset and payment notifications
# fail without it, and API boot refuses to start. The template targets Resend
# (smtp.resend.com) but any SMTP provider works (SendGrid, SES, Mailgun, Gmail).
# All five are server-only. Staging: optional but recommended; production: required.

# SMTP_HOST — SMTP server hostname. REQUIRED in production.
#   Source: your email provider (Resend: smtp.resend.com).
SMTP_HOST=smtp.gmail.com

# SMTP_PORT — 587 (STARTTLS) or 465 (implicit TLS; the code sets `secure`
#   automatically when the port is 465). Optional, default 587.
SMTP_PORT=587

# SMTP_USER — SMTP username. For Resend this is literally `resend`.
#   REQUIRED in production.
SMTP_USER=your_email@gmail.com

# SMTP_PASS — SMTP password / API key. REQUIRED in production and rejected if
#   it still looks like a placeholder. Store in a password manager.
#   Source: provider dashboard → API keys (Resend: https://resend.com/api-keys).
#   Staging and production: use separate keys where the provider allows it.
SMTP_PASS=your_app_password

# SMTP_FROM — sender shown to recipients, `Name <address@domain>`.
#   REQUIRED in production. The DOMAIN MUST BE VERIFIED with your provider
#   (SPF + DKIM) or mail lands in spam.
#   `onboarding@resend.dev` is rejected at boot: it only delivers to the
#   Resend account owner.
SMTP_FROM="Lor Mentor <your_email@gmail.com>"

# SUPPORT_EMAIL — mailbox that receives new-ticket notifications from the
#   in-app Support page. Optional; falls back to the SMTP_FROM address when
#   unset, so a single-mailbox deployment needs no extra setting.
SUPPORT_EMAIL=""


# ── AI (Google Gemini) ─────────────────────────────────────────────────────
# GEMINI_API_KEY
#   Authenticates AI jobs, the tutor, and Anatomy Lab features.
#   Required only if those features are used. Server-only.
#   Source: https://aistudio.google.com/apikey. Staging and production:
#   separate keys are recommended (quota isolation).
GEMINI_API_KEY=your_gemini_api_key

# GEMINI_MODEL — model override. Optional; the code default is
#   `gemini-3.8-flash` (apps/api/src/modules/ai/gemini.service.ts). Pin a
#   different model here only if the default is retired or you need another one.
#   Server-only. Staging and production: normally identical.
GEMINI_MODEL=gemini-3.8-flash


# ── Redis (cache, BullMQ jobs, token denylist) ─────────────────────────────
# Redis is internal to the Docker network and has no password support in the
# application — never publish its port. Server-only values.

# REDIS_HOST — REQUIRED for Docker deploys (`redis` = compose service name).
#   Local dev: localhost.
REDIS_HOST=localhost

# REDIS_PORT — optional, default 6379.
REDIS_PORT=6379

# REDIS_FAIL_MODE
#   Behaviour when Redis is unavailable. `closed` (default) rejects refresh
#   attempts rather than allowing unverified tokens; `open` is a local-debug
#   escape hatch only and is never appropriate in production.
#   Server-only. Staging = production = `closed`.
REDIS_FAIL_MODE=closed


# ── Chapa (online payments — OPTIONAL) ─────────────────────────────────────
# The bank-transfer + manual-review flow is the primary payment path. Leave
# BOTH secret keys blank to launch without Chapa; a half-configuration is
# rejected at boot (all-or-nothing). Server-only.
#   Staging: TEST keys (CHASECK_TEST-...). Production: LIVE keys.
#   Never reuse test keys in production — Chapa will reject live charges.

# CHAPA_BASE_URL — API base. Optional, default https://api.chapa.co/v1.
CHAPA_BASE_URL=https://api.chapa.co/v1

# CHAPA_SECRET_KEY — API secret. Source: https://dashboard.chapa.co →
#   Settings → API. Blank = Chapa disabled.
CHAPA_SECRET_KEY=

# CHAPA_WEBHOOK_SECRET — the "Secret hash" from the Chapa Webhooks page.
#   Every webhook payload is signed with it (HMAC-SHA256, timing-safe compare).
#   Required whenever CHAPA_SECRET_KEY is set.
CHAPA_WEBHOOK_SECRET=

# CHAPA_RETRY_WINDOW_MINUTES — how long an unpaid Chapa checkout stays
#   resumable before lazy resolution may close it. Optional, default 60.
#   Match the checkout/retry timeout configured in the Chapa dashboard. A
#   payment younger than this is never treated as abandoned, and an older one
#   is expired only after Chapa confirms the checkout link is dead
#   (PUT /transaction/cancel); an unreachable gateway changes nothing.
CHAPA_RETRY_WINDOW_MINUTES=60


# ── Bank-receipt auto-verification (receipt-verifier service) ──────────────
# OPTIONAL. When disabled, receipts fall back to manual admin review.
# Server-only.

# RECEIPT_VERIFIER_URL
#   Internal URL of the Python verifier. Compose sets this automatically to
#   http://verifier:8000; leave blank to disable the feature entirely.
RECEIPT_VERIFIER_URL=

# RECEIPT_VERIFIER_TOKEN
#   Shared secret the API sends as the `x-verifier-token` header. REQUIRED
#   whenever RECEIPT_VERIFIER_URL is set; >= 32 chars in production.
#   Compose passes it to the verifier as VERIFIER_SHARED_TOKEN, so the two can
#   never drift. Source: `openssl rand -hex 24`.
#   Staging and production: DIFFERENT values.
RECEIPT_VERIFIER_TOKEN=

# RECEIPT_VERIFIER_TIMEOUT_MS — per-attempt timeout. Optional, default 60000.
#   Allowed range 5000–120000. Keep nginx's proxy_read_timeout (180s) above it.
RECEIPT_VERIFIER_TIMEOUT_MS=60000

# COMPANY_BANK_ACCOUNTS / COMPANY_BANK_ACCOUNT_LABELS
#   Legacy matching-only fallback. Live receiving accounts are managed in
#   /admin/banks and stored in the database. Optional; entries need >= 8 digits.
COMPANY_BANK_ACCOUNTS=
COMPANY_BANK_ACCOUNT_LABELS=


# ── Cheki receipt verification (primary automated source) ──────────────────
# Free public service (https://cheki.et) that reads the bank's own records. No
# API key. The verifier service above is the fallback when Cheki is unreachable.
# Server-only. Staging and production: normally identical settings.

# CHEKI_ENABLED — kill switch. `"false"` disables Cheki without a redeploy.
CHEKI_ENABLED="true"

# CHEKI_BASE_URL — service base URL.
CHEKI_BASE_URL="https://cheki.et"

# CHEKI_TIMEOUT_MS — per-attempt timeout (ms). Default 20000.
CHEKI_TIMEOUT_MS="20000"

# CHEKI_CACHE_TTL_MS — how long a verification result is cached (ms).
#   Default 300000 (5 min). Lower = more upstream calls; higher = staler results.
CHEKI_CACHE_TTL_MS="300000"


# ── Error monitoring (OPTIONAL) ────────────────────────────────────────────
# SENTRY_DSN
#   Enables Sentry error reporting. Leave blank to disable; production errors
#   are then visible only in container logs.
#   Server-only. Source: sentry.io → project settings → Client Keys (DSN).
#   Staging and production: use separate projects if possible.
SENTRY_DSN=


# ── Initial super admin (one-time seed only) ───────────────────────────────
# Read by `npm run db:seed`, not by the running API. Not needed afterwards.
# Server-only; SUPER_ADMIN_PASSWORD is sensitive. The seed never overwrites an
# existing super admin, so set these BEFORE the first seed.

# SUPER_ADMIN_EMAIL — login email for the first administrator. Required to seed.
SUPER_ADMIN_EMAIL="admin@example.com"

# SUPER_ADMIN_PASSWORD — long, unique, stored in a password manager.
#   Required to seed. Change it from the UI after first login if you wish.
SUPER_ADMIN_PASSWORD="replace-with-a-long-unique-random-password"

# SUPER_ADMIN_NAME — display name. Optional, default "Super Admin".
SUPER_ADMIN_NAME="Platform Administrator"


# ── Frontend (Next.js) ─────────────────────────────────────────────────────
# NEXT_PUBLIC_API_URL
#   The ONLY browser-exposed variable. It is a public origin, never a secret.
#   It is used TWICE: inlined into the client bundle at BUILD time, and read at
#   RUNTIME by server components, route handlers and next.config.ts rewrites.
#   REQUIRED for Docker deploys: compose supplies it as both a build arg and a
#   runtime env var. Must be absolute. Must not be localhost in production.
#   Mobile/LAN dev: set your machine's LAN IP so a phone can reach the API.
#   Staging and production: different hosts.
#   Validated in apps/web/src/lib/api-base.ts. In a production build an empty
#   value, a non-absolute URL, an origin carrying a path, or a loopback/private
#   address all fail the build (and /api/proxy returns 503 at runtime) instead
#   of silently falling back to localhost.
NEXT_PUBLIC_API_URL=http://localhost:4000

# ALLOW_LOCAL_API_ORIGIN
#   Local-only escape hatch so `npm run build` (which always runs with
#   NODE_ENV=production) can be smoke-tested against a localhost API. It
#   relaxes ONLY the loopback rule — never set it in a deployment.
# ALLOW_LOCAL_API_ORIGIN=1

# NOTE: browser code must never receive a secret. If a value is sensitive it
# must NOT be prefixed with NEXT_PUBLIC_. There are deliberately no other
# NEXT_PUBLIC_ variables in this project.

# ── Test / tooling only (never set in production) ──────────────────────────
# E2E_BASE_URL — Playwright base URL. Optional, default http://localhost:3000.
# ANALYZE       — `"true"` enables the Next.js bundle analyzer. Optional.
# CI            — set by the CI runner; not for manual configuration.


# ── Storage ────────────────────────────────────────────────────────────────
# There are NO storage environment variables. Uploaded bank receipts, materials
# and generated PDF receipts are written to `<cwd>/uploads/...` and persisted by
# the `uploads` named volume at /app/apps/api/uploads (created and chowned to
# the `node` user in apps/api/Dockerfile). Upload size limits are fixed in code
# (25 MB materials, 10 MB receipts) and mirrored by nginx `client_max_body_size
# 30m`. Back this volume up separately — see docs/deploy/BACKUP-RESTORE.md.