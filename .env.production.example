# ============================================================================
# Lor Mentor — PRODUCTION / STAGING environment
# ----------------------------------------------------------------------------
# Copy to `.env.production` on the VPS, fill in every CHANGE_ME_* value, then:
#   chmod 600 .env.production
#   npm run check:env -- .env.production            # duplicates / structure
#   npm run check:env -- .env.production --strict   # placeholders / localhost
#
# `.env.production` is BOTH the compose --env-file (for ${VAR} substitution)
# and the API service's env_file. It is git-ignored — never commit it.
#
# Full per-variable documentation (purpose, exposure, where to obtain each
# value, staging-vs-production deltas) lives in `.env.example`. This file keeps
# the same key set as `.env.example` with production values.
#
# STAGING uses this same file. Only the VALUES differ from production:
# different domains/DB password/JWT secrets, Chapa TEST keys, separate
# RECEIPT_VERIFIER_TOKEN, and its own COOKIE_DOMAIN.
# ============================================================================

# ── Application ────────────────────────────────────────────────────────────
NODE_ENV=production
# Port the API listens on inside its container; nginx proxies here.
PORT=4000

# Public HTTPS origins — no localhost, no trailing slash. Chapa callbacks,
# email links, password-reset URLs and CORS are built from these.
WEB_PUBLIC_URL=https://lormentor.com
API_PUBLIC_URL=https://api.lormentor.com
# Legacy fallback for email links. Keep equal to WEB_PUBLIC_URL.
APP_URL=https://lormentor.com
COLLEGE_NAME="Lorcan Medical College"
APP_NAME="Lor Mentor"

# ── CORS ───────────────────────────────────────────────────────────────────
# Exact frontend origin(s), comma-separated. Wildcards are rejected at
# preflight and at API boot.
CORS_ORIGIN=https://lormentor.com

# ── Reverse proxy / cookies ────────────────────────────────────────────────
# Reverse-proxy hops Express trusts for X-Forwarded-For.
# Blank = 1 in production (single nginx). Use 2 if Cloudflare is in front.
# Never use `true`.
TRUST_PROXY=

# REQUIRED for this topology: the web app is on lormentor.com and the API on
# api.lormentor.com. Auth cookies are set on the API host, so without a shared
# parent domain the web edge guard and /api/proxy never see a session and every
# protected page redirects to /login.
# Format: bare parent domain with a leading dot. No scheme, port or wildcard.
COOKIE_DOMAIN=.lormentor.com

# ── Database (PostgreSQL, internal to the compose network) ─────────────────
POSTGRES_USER=lor
# Generate with: openssl rand -hex 24   (URL-safe characters only).
# If it contains @ : / # % ? it corrupts DATABASE_URL below. The password in
# DATABASE_URL MUST always be updated when this value changes.
POSTGRES_PASSWORD=CHANGE_ME_URL_SAFE_hex_password
POSTGRES_DB=lor_mentor
# Host is the compose service name `postgres`, not localhost.
DATABASE_URL=postgresql://lor:CHANGE_ME_URL_SAFE_hex_password@postgres:5432/lor_mentor

# ── Authentication / JWT (generate with: openssl rand -hex 48) ─────────────
# >= 32 characters, high-entropy, and DIFFERENT from each other.
# These two are the highest-sensitivity values in this file.
JWT_ACCESS_SECRET=CHANGE_ME_openssl_rand_hex_48
JWT_REFRESH_SECRET=CHANGE_ME_DIFFERENT_openssl_rand_hex_48
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Email (SMTP — Resend by default) ───────────────────────────────────────
# REQUIRED in production: password reset and payment notices depend on it.
# Verify the sending domain (SPF + DKIM) or mail lands in spam.
# For Resend: host smtp.resend.com, user `resend`, password = API key.
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=CHANGE_ME_smtp_api_key
# Must be on a domain you have verified with your provider.
# onboarding@resend.dev is rejected at boot (it only delivers to the owner).
SMTP_FROM="Lor Mentor <no-reply@lormentor.com>"

# ── AI (Google Gemini) ─────────────────────────────────────────────────────
GEMINI_API_KEY=CHANGE_ME_gemini_api_key
# Default matches the code (gemini-3.8-flash); override only deliberately.
GEMINI_MODEL=gemini-3.8-flash

# ── Redis (internal; host is the compose service name) ─────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
# `closed` = fail closed when Redis is down (refresh attempts rejected).
# `open` is a local-debug escape hatch only. Leave as `closed`.
REDIS_FAIL_MODE=closed

# ── Chapa online payments (OPTIONAL — leave ALL blank to launch without it) ─
# The bank-transfer + manual-review flow is the primary payment path.
# Set both secret keys together or neither (enforced at boot).
# STAGING: CHASECK_TEST-* keys. PRODUCTION: live keys (test keys are refused
# at boot). Mode on every verified transaction must be test/live to match.
CHAPA_BASE_URL=https://api.chapa.co/v1
CHAPA_SECRET_KEY=
CHAPA_WEBHOOK_SECRET=
# How long an unpaid checkout stays resumable (default 60). Match the Chapa
# dashboard's checkout/retry timeout; older payments are closed only after
# Chapa confirms the link is dead.
CHAPA_RETRY_WINDOW_MINUTES=60

# ── Bank-receipt auto-verification (receipt-verifier service) ──────────────
# Compose sets the URL automatically; leave it as-is here.
RECEIPT_VERIFIER_URL=http://verifier:8000
# Shared secret with the Python verifier (openssl rand -hex 24). >= 32 chars.
# Compose passes it to the verifier as VERIFIER_SHARED_TOKEN.
RECEIPT_VERIFIER_TOKEN=CHANGE_ME_openssl_rand_hex_24
# Live bank extraction can take longer than a normal API call (5000-120000).
RECEIPT_VERIFIER_TIMEOUT_MS=60000
# OPTIONAL legacy matching fallback only. Live receiving accounts are managed
# in /admin/banks and stored in the database.
COMPANY_BANK_ACCOUNTS=
COMPANY_BANK_ACCOUNT_LABELS=

# ── Cheki receipt verification (primary automated source) ──────────────────
CHEKI_ENABLED="true"
CHEKI_BASE_URL="https://cheki.et"
CHEKI_TIMEOUT_MS="20000"
CHEKI_CACHE_TTL_MS="300000"

# ── Error monitoring (OPTIONAL) ────────────────────────────────────────────
# Leave blank to disable. Without it, production errors are visible only in
# container logs.
SENTRY_DSN=

# ── Initial super admin (one-time seed only) ───────────────────────────────
# Consumed by the seed, not the running API. The seed never overwrites an
# existing super admin, so set these BEFORE the first seed.
SUPER_ADMIN_EMAIL=admin@lormentor.com
SUPER_ADMIN_PASSWORD=CHANGE_ME_long_unique_admin_password
SUPER_ADMIN_NAME="Platform Administrator"

# ── Frontend (Next.js) ─────────────────────────────────────────────────────
# The ONLY browser-exposed value — a public origin, never a secret.
# Used twice: inlined into the client bundle at BUILD time (compose build arg)
# and read at RUNTIME by server components, route handlers and rewrites.
# Removing either copy breaks the web app.
NEXT_PUBLIC_API_URL=https://api.lormentor.com