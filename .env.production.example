# ============================================================================
# Lor Mentor — PRODUCTION environment (docker-compose.prod.yml)
# ----------------------------------------------------------------------------
# Copy to `.env.production` on the VPS and fill in real values. NEVER commit the
# filled file (.gitignore already excludes .env.production). Used both as the
# compose --env-file (for ${VAR} substitution) and each service's env_file.
#
# Before deploying, run the preflight (detects duplicate keys and placeholders):
#   npm run check:env -- .env.production
# ============================================================================

# ── Core ────────────────────────────────────────────────────────────
NODE_ENV=production

# Public URLs — must be the real HTTPS origins (no localhost). Chapa callbacks,
# email links and CORS are built from these.
WEB_PUBLIC_URL=https://lormentor.com
API_PUBLIC_URL=https://api.lormentor.com
APP_URL=https://lormentor.com
API_URL=https://api.lormentor.com
COLLEGE_NAME=Lorcan Medical College
APP_NAME=Lor Mentor

# CORS: the exact frontend origin(s) allowed to call the API (comma-separated).
CORS_ORIGIN=https://lormentor.com

# Browser-facing API URL, inlined into the web bundle at build time.
NEXT_PUBLIC_API_URL=https://api.lormentor.com

# ── PostgreSQL (internal to the compose network) ────────────────────
POSTGRES_USER=lor
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_DB=lor_mentor
# Host is the compose service name `postgres`, not localhost.
DATABASE_URL=postgresql://lor:CHANGE_ME_strong_db_password@postgres:5432/lor_mentor

# ── JWT (generate with: openssl rand -hex 48) ───────────────────────
# Must be >= 32 chars, high-entropy, and DIFFERENT from each other.
JWT_ACCESS_SECRET=CHANGE_ME_openssl_rand_hex_48
JWT_REFRESH_SECRET=CHANGE_ME_DIFFERENT_openssl_rand_hex_48
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Email (transactional SMTP — e.g. Resend / SendGrid / SES / Mailgun) ──
# Verify your sending domain (SPF + DKIM) for inbox delivery.
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=CHANGE_ME_smtp_api_key
# Must use the domain verified in Resend (F-8). Never use onboarding@resend.dev
# for production: it only delivers to the Resend account owner.
SMTP_FROM=Lor Mentor <no-reply@lormentor.com>

# ── Initial super admin (required by the one-time seed) ─────────────
# Use a unique password, store it in a password manager, and keep this file
# readable only by the deploy user (`chmod 600 .env.production`).
SUPER_ADMIN_EMAIL=admin@lormentor.com
SUPER_ADMIN_PASSWORD=CHANGE_ME_long_unique_admin_password
SUPER_ADMIN_NAME=Platform Administrator

# ── Gemini AI ───────────────────────────────────────────────────────
GEMINI_API_KEY=CHANGE_ME_gemini_api_key
# Optional. Override the model used by AI jobs, the tutor, and Anatomy Lab.
GEMINI_MODEL=gemini-2.5-flash

# ── Redis (internal; host is the service name) ──────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
# Revoked-refresh-token checks fail CLOSED by default: if Redis is down,
# refresh attempts are rejected rather than allowed through unverified.
# `open` is a local-debug escape hatch only; leave this as `closed`.
REDIS_FAIL_MODE=closed

# ── Chapa online payments (OPTIONAL — leave ALL blank to launch without it) ──
# The bank-transfer + manual-review flow is the primary payment path. When you
# get LIVE keys, set BOTH together (env validation enforces all-or-nothing).
CHAPA_BASE_URL=https://api.chapa.co/v1
CHAPA_SECRET_KEY=
CHAPA_WEBHOOK_SECRET=

# ── Bank-receipt auto-verification (receipt-verifier service) ───────
# URL is set by compose to http://verifier:8000 — leave as-is here.
RECEIPT_VERIFIER_URL=http://verifier:8000
# Shared secret between API and the Python verifier (openssl rand -hex 24).
RECEIPT_VERIFIER_TOKEN=
# Live bank extraction can take longer than a normal API call.
RECEIPT_VERIFIER_TIMEOUT_MS=60000
# OPTIONAL legacy matching fallback only. Public receiving accounts are
# configured in /admin/banks and stored in the database; env-only accounts are
# never listed to students. Auto-approval matches DB accounts first, then these.
COMPANY_BANK_ACCOUNTS=
# Optional labels for the legacy env accounts above (not used by the public
# transfer panel, which reads DB account labels).
COMPANY_BANK_ACCOUNT_LABELS=

# ── Cheki receipt verification (PRIMARY automated source) ────────────────
# Free, no-API-key public service (https://cheki.et) that reads the bank's own
# records. The receipt-verifier service above is kept as FALLBACK: when Cheki
# is unreachable, rate-limited, or cannot decode a receipt, the verifier is
# tried next. Only bank-confirmed data (Cheki verified === true, or the
# verifier's official-endpoint extraction) can auto-approve a payment.
# Set CHEKI_ENABLED="false" for a controlled rollout without Cheki.
CHEKI_ENABLED="true"
CHEKI_BASE_URL="https://cheki.et"
# Strict per-attempt timeout (ms); Cheki calls are made server-side only.
CHEKI_TIMEOUT_MS="20000"
