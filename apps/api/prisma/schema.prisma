generator client {
  provider = "prisma-client-js"
  output   = "../../../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  // URL is configured in prisma.config.ts — Prisma 7 style
}

// ─── ENUMS ────────────────────────────────────
enum Role {
  GUEST
  STUDENT
  TEACHER
  ADMIN
  SUPER_ADMIN
}

enum MaterialType {
  PDF
  IMAGE
  YOUTUBE
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  EXPIRED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
  // An approved payment that was later invalidated by a super admin (wrong
  // student, refunded, fraudulent receipt found after review). Only APPROVED
  // rows can be reversed; the original approval fields stay intact.
  REVERSED
}

// How a payment was made:
//  - MANUAL: student transferred to the college account and uploaded a receipt
//    image; an admin reviews and approves it.
//  - CHAPA: student paid online through the Chapa gateway (telebirr, CBE,
//    bank, card); approved automatically once Chapa confirms the transaction.
enum PaymentMethod {
  MANUAL
  CHAPA
}

enum AiStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum NotificationType {
  PAYMENT_APPROVED
  PAYMENT_REJECTED
  PAYMENT_REVERSED
  SUBSCRIPTION_EXPIRING
  SUBSCRIPTION_EXPIRED
  NEW_CONTENT
  NEW_ANNOUNCEMENT
  FORUM_REPLY
  AI_COMPLETE
}

// ─── USERS ────────────────────────────────────
model User {
  id                  String    @id @default(cuid())
  email               String    @unique
  passwordHash        String
  fullName            String
  avatarPath          String?
  phoneNumber         String?
  departmentId        String?
  academicYearId      String?
  role                Role      @default(STUDENT)
  isActive            Boolean   @default(true)
  isEmailVerified     Boolean   @default(false)
  emailVerifyToken    String?
  emailVerifyExpiry   DateTime?
  passwordResetToken  String?
  passwordResetExpiry DateTime?
  // Brute-force protection: failed logins accumulate here and reset on success;
  // once the threshold is hit the account is locked until lockoutUntil.
  failedLoginCount    Int       @default(0)
  lockoutUntil        DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  // Relations
  subscription     Subscription?
  payments         Payment[]
  teacherCourses   Course[]          @relation("CourseTeacher")
  department       Department?       @relation(fields: [departmentId], references: [id])
  academicYear     AcademicYear?     @relation(fields: [academicYearId], references: [id])
  progressRecords  ProgressRecord[]
  quizAttempts     QuizAttempt[]
  flashcardReviews FlashcardReview[]
  aiHistory        AiHistory[]
  forumPosts       ForumPost[]
  forumReplies     ForumReply[]
  reactions        Reaction[]
  reports          Report[]
  notifications    Notification[]
  auditLogs        AuditLog[]

  @@index([email])
  @@index([role])
}

// ─── SUBSCRIPTIONS ────────────────────────────
model SubscriptionPlan {
  id             String   @id @default(cuid())
  name           String
  description    String?
  priceETB       Decimal
  durationMonths Int
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  subscriptions Subscription[]
  payments      Payment[]
}

model Subscription {
  id        String             @id @default(cuid())
  userId    String             @unique
  planId    String
  status    SubscriptionStatus @default(PENDING)
  startDate DateTime?
  endDate   DateTime?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  user     User             @relation(fields: [userId], references: [id])
  plan     SubscriptionPlan @relation(fields: [planId], references: [id])
  payments Payment[]
}

model Payment {
  id             String        @id @default(cuid())
  userId         String
  planId         String
  subscriptionId String?
  method         PaymentMethod @default(MANUAL)

  // MANUAL payments carry an uploaded receipt image (filename under
  // uploads/receipts). CHAPA payments have none, so this is now optional.
  receiptPath String?

  // Amount actually charged, snapshotted from the plan at payment time so a
  // later price change never rewrites historical records. Currency is ETB.
  amount   Decimal?
  currency String   @default("ETB")

  // ── Chapa gateway fields (null for MANUAL payments) ──
  // txRef is OUR unique reference sent to Chapa (idempotency key for webhooks).
  // chapaRef is Chapa's own transaction reference returned on verification.
  txRef    String?   @unique
  chapaRef String?
  paidAt   DateTime?

  // ── Bank-transfer auto-verification fields (MANUAL method) ──
  // Populated when a student submits a transaction reference we verify against
  // the bank via the receipt-verifier service. bankReference is the FT/
  // transaction number; its @unique constraint is the anti-replay guard — the
  // same real receipt can never be submitted twice. `verification` stores the
  // normalized extractor payload for the admin panel and audit trail.
  bankName      String?
  bankReference String? @unique
  verification  Json?

  // Human-facing receipt number, assigned once a payment is APPROVED. Drives
  // the auto-generated PDF receipt. Null while PENDING/REJECTED.
  receiptNumber String? @unique

  status          PaymentStatus @default(PENDING)
  rejectionReason String?
  reviewedBy      String? // admin userId for MANUAL; null for CHAPA auto-approval
  reviewedAt      DateTime?

  // ── Reversal fields (APPROVED → REVERSED) ──
  // Set when a super admin reverses a previously approved payment. The
  // approval fields above are never rewritten; these record the reversal.
  reversalReason String?
  reversedBy     String? // super-admin userId who reversed it
  reversedAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user         User             @relation(fields: [userId], references: [id])
  plan         SubscriptionPlan @relation(fields: [planId], references: [id])
  subscription Subscription?    @relation(fields: [subscriptionId], references: [id])

  @@index([userId, status])
  @@index([status])
}

/**
 * Admin-managed list of banks the college accepts payments from. The catalog
 * itself (labels, required input, auto-verify capability) lives in
 * bank-catalog.ts; this table only records which catalog entries are enabled.
 * Removing a row never touches existing payments (bankName is a snapshot).
 */
model AcceptedBank {
  id        String   @id @default(cuid())
  code      String   @unique
  isActive  Boolean  @default(true)

  // College receiving account for this bank. Optional because a bank can be
  // enabled before its account is entered; digit-only, validated per bank
  // (CBE legacy lookup uses the last 8, BOA the last 5). The full number is
  // shown to students and matched against the receiver on bank receipts.
  accountNumber String? @unique
  accountName   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── ACADEMIC STRUCTURE ───────────────────────
model Department {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  coverImage  String?
  isArchived  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  academicYears AcademicYear[] // ✅ Fixed: Inverse tracking array added cleanly
  users         User[]
}

model AcademicYear {
  id           String   @id @default(cuid())
  departmentId String
  label        String
  isArchived   Boolean  @default(false)
  createdAt    DateTime @default(now())

  department Department @relation(fields: [departmentId], references: [id])
  semesters  Semester[]
  students   User[]
}

model Semester {
  id             String   @id @default(cuid())
  academicYearId String
  name           String
  isArchived     Boolean  @default(false)
  createdAt      DateTime @default(now())

  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])
  courses      Course[]
}

// ─── COURSES ──────────────────────────────────
model Course {
  id          String   @id @default(cuid())
  semesterId  String
  teacherId   String?
  title       String
  description String?
  coverImage  String?
  isPublished Boolean  @default(false)
  isArchived  Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  semester      Semester       @relation(fields: [semesterId], references: [id])
  teacher       User?          @relation("CourseTeacher", fields: [teacherId], references: [id])
  materials     Material[]
  quizzes       Quiz[]
  announcements Announcement[] // ✅ Explicit relation tracker mapped here
  forumSection  ForumSection?

  @@index([semesterId])
  @@index([teacherId])
}

// ─── MATERIALS ────────────────────────────────
model Material {
  id         String       @id @default(cuid())
  courseId   String
  title      String
  type       MaterialType
  filePath   String?
  youtubeUrl String?
  isSample   Boolean      @default(false)
  sortOrder  Int          @default(0)
  uploadedBy String
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  course          Course           @relation(fields: [courseId], references: [id])
  aiContent       AiContent?
  progressRecords ProgressRecord[]

  @@index([courseId])
}

// ─── AI CONTENT ───────────────────────────────
model AiContent {
  id               String   @id @default(cuid())
  materialId       String   @unique
  status           AiStatus @default(PENDING)
  summary          String?
  keyTopics        Json?
  illustrationPath String?
  error            String? // failure reason when status = FAILED (cleared on success)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  material     Material      @relation(fields: [materialId], references: [id])
  flashcardSet FlashcardSet?
  quizBank     QuizBank?
}

// ─── FLASHCARDS ───────────────────────────────
model FlashcardSet {
  id          String   @id @default(cuid())
  aiContentId String   @unique
  title       String
  createdAt   DateTime @default(now())

  aiContent AiContent         @relation(fields: [aiContentId], references: [id])
  cards     Flashcard[]
  reviews   FlashcardReview[]
}

model Flashcard {
  id             String @id @default(cuid())
  flashcardSetId String
  front          String
  back           String
  sortOrder      Int    @default(0)

  flashcardSet FlashcardSet @relation(fields: [flashcardSetId], references: [id])
}

model FlashcardReview {
  id             String   @id @default(cuid())
  userId         String
  flashcardSetId String
  cardId         String
  isKnown        Boolean
  reviewedAt     DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id])
  flashcardSet FlashcardSet @relation(fields: [flashcardSetId], references: [id])

  @@unique([userId, cardId])
}

// ─── QUIZZES ──────────────────────────────────
model QuizBank {
  id          String   @id @default(cuid())
  aiContentId String   @unique
  createdAt   DateTime @default(now())

  aiContent AiContent  @relation(fields: [aiContentId], references: [id])
  questions Question[]
  // The takeable Quiz anchored to this bank (created lazily on first attempt)
  quiz      Quiz?
}

model Quiz {
  id            String   @id @default(cuid())
  courseId      String
  title         String
  isAiGenerated Boolean  @default(false)
  createdBy     String
  createdAt     DateTime @default(now())
  // Optional link to the AI-generated bank this quiz draws its questions from.
  // Unique so each bank maps to at most one Quiz (the attempt anchor).
  quizBankId    String?  @unique

  course    Course        @relation(fields: [courseId], references: [id])
  quizBank  QuizBank?     @relation(fields: [quizBankId], references: [id])
  questions Question[]
  attempts  QuizAttempt[]
}

model Question {
  id            String  @id @default(cuid())
  quizId        String?
  quizBankId    String?
  text          String
  options       Json
  correctOption String
  explanation   String?
  sortOrder     Int     @default(0)

  quiz     Quiz?        @relation(fields: [quizId], references: [id])
  quizBank QuizBank?    @relation(fields: [quizBankId], references: [id])
  answers  QuizAnswer[]

  @@index([quizBankId])
  @@index([quizId])
}

model QuizAttempt {
  id          String   @id @default(cuid())
  userId      String
  quizId      String
  score       Float
  totalQ      Int
  timeTaken   Int
  completedAt DateTime @default(now())

  user    User         @relation(fields: [userId], references: [id])
  quiz    Quiz         @relation(fields: [quizId], references: [id])
  answers QuizAnswer[]

  @@index([userId])
  @@index([quizId])
}

model QuizAnswer {
  id         String  @id @default(cuid())
  attemptId  String
  questionId String
  selected   String
  isCorrect  Boolean

  attempt  QuizAttempt @relation(fields: [attemptId], references: [id])
  question Question    @relation(fields: [questionId], references: [id])

  @@index([attemptId])
  @@index([questionId])
}

// ─── AI TUTOR HISTORY ─────────────────────────
model AiHistory {
  id         String   @id @default(cuid())
  userId     String
  courseId   String?
  materialId String?
  prompt     String
  response   String
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

// ─── FORUM ────────────────────────────────────
model ForumSection {
  id       String  @id @default(cuid())
  courseId String? @unique
  type     String

  course Course?     @relation(fields: [courseId], references: [id])
  posts  ForumPost[]
}

model ForumPost {
  id        String   @id @default(cuid())
  sectionId String
  authorId  String
  title     String
  content   String
  isPinned  Boolean  @default(false)
  isRemoved Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  section   ForumSection @relation(fields: [sectionId], references: [id])
  author    User         @relation(fields: [authorId], references: [id])
  replies   ForumReply[]
  reactions Reaction[]
  reports   Report[]

  @@index([sectionId])
  @@index([authorId])
}

model ForumReply {
  id        String   @id @default(cuid())
  postId    String
  authorId  String
  content   String
  isRemoved Boolean  @default(false)
  createdAt DateTime @default(now())

  post      ForumPost  @relation(fields: [postId], references: [id])
  author    User       @relation(fields: [authorId], references: [id])
  reactions Reaction[]
  reports   Report[]

  @@index([postId])
  @@index([authorId])
}

// ─── NOTIFICATIONS ────────────────────────────
model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  isRead    Boolean          @default(false)
  meta      Json?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, isRead])
}

// ─── PROGRESS ─────────────────────────────────
model ProgressRecord {
  id         String   @id @default(cuid())
  userId     String
  materialId String
  viewedAt   DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id])
  material Material @relation(fields: [materialId], references: [id])

  @@unique([userId, materialId])
}

// ─── ANNOUNCEMENTS ────────────────────────────
model Announcement {
  id        String   @id @default(cuid())
  courseId  String
  authorId  String
  title     String
  content   String
  createdAt DateTime @default(now())

  course Course @relation(fields: [courseId], references: [id])

  @@index([courseId])
}

// ─── AUDIT LOGS ───────────────────────────────
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String?
  entityId   String?
  meta       Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id])

  @@index([actorId])
  @@index([action])
  @@index([createdAt])
}

// ─── FORUM REACTIONS & REPORTS ────────────────
enum ReactionType {
  LIKE
  LOVE
  TARGET
  FIRE
}

enum ReportReason {
  SPAM
  OFFENSIVE
  OFF_TOPIC
  OTHER
}

enum ReportStatus {
  PENDING
  ACTIONED
  DISMISSED
}

// A user's reaction on a forum post OR reply (exactly one of postId/replyId set)
model Reaction {
  id        String       @id @default(cuid())
  userId    String
  postId    String?
  replyId   String?
  type      ReactionType
  createdAt DateTime     @default(now())

  user  User        @relation(fields: [userId], references: [id])
  post  ForumPost?  @relation(fields: [postId], references: [id])
  reply ForumReply? @relation(fields: [replyId], references: [id])

  // One reaction of a given type per user per post / per reply
  @@unique([userId, postId, type])
  @@unique([userId, replyId, type])
  @@index([postId])
  @@index([replyId])
}

// A report flagging a forum post OR reply for moderation
model Report {
  id         String       @id @default(cuid())
  reporterId String
  postId     String?
  replyId    String?
  reason     ReportReason
  note       String?
  status     ReportStatus @default(PENDING)
  reviewedBy String?
  reviewedAt DateTime?
  createdAt  DateTime     @default(now())

  reporter User        @relation(fields: [reporterId], references: [id])
  post     ForumPost?  @relation(fields: [postId], references: [id])
  reply    ForumReply? @relation(fields: [replyId], references: [id])

  @@index([status])
  @@index([postId])
  @@index([replyId])
  @@index([reporterId])
}
