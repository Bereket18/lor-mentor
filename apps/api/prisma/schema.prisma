generator client {
  provider = "prisma-client-js"
  output   = "../../../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  // URL is configured in prisma.config.ts — Prisma 7 style
}

// ─── ENUMS ────────────────────────────────────
enum Role {
  GUEST
  STUDENT
  TEACHER
  ADMIN
  SUPER_ADMIN
}

enum MaterialType {
  PDF
  IMAGE
  YOUTUBE
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  EXPIRED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
  // An approved payment that was later invalidated by a super admin (wrong
  // student, refunded, fraudulent receipt found after review). Only APPROVED
  // rows can be reversed; the original approval fields stay intact.
  REVERSED
  // Terminal: an abandoned/failed Chapa checkout older than the abandonment
  // window, expired lazily at the next initialize attempt (PAYMENT_EXPIRED).
  EXPIRED
  // Terminal: the student cancelled their own PENDING online checkout
  // (PAYMENT_CANCELLED).
  CANCELLED
}

// How a payment was made:
//  - MANUAL: student transferred to the college account and uploaded a receipt
//    image; an admin reviews and approves it.
//  - CHAPA: student paid online through the Chapa gateway (telebirr, CBE,
//    bank, card); approved automatically once Chapa confirms the transaction.
enum PaymentMethod {
  MANUAL
  CHAPA
}

enum AiStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum NotificationType {
  PAYMENT_APPROVED
  PAYMENT_REJECTED
  PAYMENT_REVERSED
  SUBSCRIPTION_EXPIRING
  SUBSCRIPTION_EXPIRED
  NEW_CONTENT
  NEW_ANNOUNCEMENT
  FORUM_REPLY
  AI_COMPLETE
}

// What a short verification code was issued for. Stored as a column so a code
// issued for one purpose is a different row from a code issued for another and
// can never validate across purposes.
//
// PASSWORD_RESET is reserved: password reset still uses its own
// `passwordResetToken`/`passwordResetExpiry` columns and an emailed link. The
// value exists so the separation is explicit and testable, and so a future
// move of password reset onto codes needs no schema change.
enum VerificationPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

// ─── USERS ────────────────────────────────────
model User {
  id                  String    @id @default(cuid())
  email               String    @unique
  passwordHash        String
  fullName            String
  avatarPath          String?
  phoneNumber         String?
  departmentId        String?
  academicYearId      String?
  role                Role      @default(STUDENT)
  isActive            Boolean   @default(true)
  isEmailVerified     Boolean   @default(false)
  // Explicit faculty anatomy sign-off permission. It is never granted
  // automatically: an administrator grants or revokes it per TEACHER account
  // through the "Manage Reviewer Access" admin screen. ADMIN/SUPER_ADMIN are
  // never reviewers.
  isAnatomyReviewer   Boolean   @default(false)
  // Superseded by the VerificationCode table below. Email verification now
  // issues a 6-digit code stored as a bcrypt hash in its own row; these two
  // columns are no longer written by any code path. They are deliberately NOT
  // dropped — production is forward-only and the drop has no benefit — so any
  // in-flight value is simply left inert. Remove in a later, separate migration.
  emailVerifyToken    String?
  emailVerifyExpiry   DateTime?
  passwordResetToken  String?
  passwordResetExpiry DateTime?
  // Brute-force protection: failed logins accumulate here and reset on success;
  // once the threshold is hit the account is locked until lockoutUntil.
  failedLoginCount    Int       @default(0)
  lockoutUntil        DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  // Relations
  subscription     Subscription?
  payments         Payment[]
  teacherCourses   Course[]          @relation("CourseTeacher")
  department       Department?       @relation(fields: [departmentId], references: [id])
  academicYear     AcademicYear?     @relation(fields: [academicYearId], references: [id])
  progressRecords  ProgressRecord[]
  quizAttempts     QuizAttempt[]
  flashcardReviews FlashcardReview[]
  aiHistory        AiHistory[]
  forumPosts       ForumPost[]
  forumReplies     ForumReply[]
  reactions        Reaction[]
  reports          Report[]
  notifications    Notification[]
  auditLogs        AuditLog[]
  anatomyRevisions AnatomyStructureRevision[] @relation("AnatomyRevisionEditor")
  reviewedStructures AnatomyStructure[]      @relation("AnatomyStructureReviewer")
  publicationApprovals AnatomySystem[]       @relation("AnatomySystemPublicationApprover")
  verificationCodes VerificationCode[]

  @@index([email])
  @@index([role])
}

// A short, single-use email verification code.
//
// Only a bcrypt hash of the 6-digit code is stored: the plaintext code is
// generated, emailed, and then discarded, so a database read never yields a
// usable code. A 6-digit code has only a 10^6 keyspace, which is why the rest
// of the defences — a 15-minute expiry, a 5-attempt budget, single-use
// consumption and rate limiting — carry the weight rather than the hash alone.
//
// Rows are never deleted on issue. Issuing a new code marks the previous active
// row `supersededAt` and inserts a new one, so "a new code invalidates the old
// one" is a fact about the data rather than a convention, and the rows remain
// countable for the per-account issuance cap.
model VerificationCode {
  id           String              @id @default(cuid())
  userId       String
  purpose      VerificationPurpose
  // bcrypt hash of the 6-digit code. Never the code itself.
  codeHash     String
  expiresAt    DateTime
  // Wrong guesses against THIS row. At MAX the row is burned: the claim and
  // increment statements both require attempts < MAX, so the cap is enforced by
  // the database rather than by read-then-write arithmetic.
  attempts     Int                 @default(0)
  // Set when the code is successfully used. Single-use is enforced by requiring
  // consumedAt IS NULL in the claiming UPDATE.
  consumedAt   DateTime?
  // Set when a newer code for the same user and purpose was issued.
  supersededAt DateTime?
  createdAt    DateTime            @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Serves both the active-row lookup and the rolling-window issuance count.
  @@index([userId, purpose, createdAt])
  // Supports sweeping expired rows without a sequential scan.
  @@index([expiresAt])
}

// ─── SUBSCRIPTIONS ────────────────────────────
model SubscriptionPlan {
  id             String   @id @default(cuid())
  name           String
  description    String?
  priceETB       Decimal
  durationMonths Int
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  subscriptions Subscription[]
  payments      Payment[]
}

model Subscription {
  id        String             @id @default(cuid())
  userId    String             @unique
  planId    String
  status    SubscriptionStatus @default(PENDING)
  startDate DateTime?
  endDate   DateTime?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  user     User             @relation(fields: [userId], references: [id])
  plan     SubscriptionPlan @relation(fields: [planId], references: [id])
  payments Payment[]
}

model Payment {
  id             String        @id @default(cuid())
  userId         String
  planId         String
  subscriptionId String?
  method         PaymentMethod @default(MANUAL)

  // MANUAL payments carry an uploaded receipt image (filename under
  // uploads/receipts). CHAPA payments have none, so this is now optional.
  receiptPath String?

  // Amount actually charged, snapshotted from the plan at payment time so a
  // later price change never rewrites historical records. Currency is ETB.
  amount   Decimal?
  currency String   @default("ETB")

  // Plan snapshot (nullable so existing rows stay untouched — no backfill).
  // Written at creation; receipts, endDate maths and audit use these when
  // present and fall back to the live plan only for pre-migration rows.
  planName           String?
  planDurationMonths Int?

  // Bank-receipt overpayment: excess over the snapshotted plan price, recorded
  // when the receipt is queued for manual review (never auto-approved).
  excessAmount Decimal?

  // ── Chapa gateway fields (null for MANUAL payments) ──
  // txRef is OUR unique reference sent to Chapa (idempotency key for webhooks).
  // chapaRef is Chapa's own transaction reference returned on verification.
  txRef    String?   @unique
  chapaRef String?
  paidAt   DateTime?
  // Hosted checkout page URL returned at initialize, so a still-open checkout
  // can be resumed instead of starting a duplicate one.
  checkoutUrl String?

  // ── Bank-transfer auto-verification fields (MANUAL method) ──
  // Populated when a student submits a transaction reference we verify against
  // the bank via the receipt-verifier service. bankReference is the FT/
  // transaction number; its @unique constraint is the anti-replay guard — the
  // same real receipt can never be submitted twice. `verification` stores the
  // normalized extractor payload for the admin panel and audit trail.
  bankName      String?
  bankReference String? @unique
  verification  Json?

  // Human-facing receipt number, assigned once a payment is APPROVED. Drives
  // the auto-generated PDF receipt. Null while PENDING/REJECTED.
  receiptNumber String? @unique

  status          PaymentStatus @default(PENDING)
  rejectionReason String?
  reviewedBy      String? // admin userId for MANUAL; null for CHAPA auto-approval
  reviewedAt      DateTime?
  // Set when a verified Chapa payment revived an EXPIRED/CANCELLED checkout
  // (EXPIRED or CANCELLED). Null for every normal approval; surfaced as a
  // "recovered" marker in the admin payment queue.
  recoveredFromStatus String?

  // ── Reversal fields (APPROVED → REVERSED) ──
  // Set when a super admin reverses a previously approved payment. The
  // approval fields above are never rewritten; these record the reversal.
  reversalReason String?
  reversedBy     String? // super-admin userId who reversed it
  reversedAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user         User             @relation(fields: [userId], references: [id])
  plan         SubscriptionPlan @relation(fields: [planId], references: [id])
  subscription Subscription?    @relation(fields: [subscriptionId], references: [id])
  events       PaymentEvent[]

  @@index([userId, status])
  @@index([status])
}

// Immutable ledger of everything that happens to a payment: every status
// transition and every notable verification outcome. Written in the same
// transaction as the status change (see PaymentStateMachine), so the ledger
// and the row can never diverge.
model PaymentEvent {
  id         String   @id @default(cuid())
  paymentId  String
  type       String
  fromStatus String?
  toStatus   String?
  actorId    String?
  reason     String?
  meta       Json?
  createdAt  DateTime @default(now())

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId, createdAt])
  @@index([type, createdAt])
}

/**
 * Admin-managed list of banks the college accepts payments from. The catalog
 * itself (labels, required input, auto-verify capability) lives in
 * bank-catalog.ts; this table only records which catalog entries are enabled.
 * Removing a row never touches existing payments (bankName is a snapshot).
 */
model AcceptedBank {
  id        String   @id @default(cuid())
  code      String   @unique
  isActive  Boolean  @default(true)

  // College receiving account for this bank. Optional because a bank can be
  // enabled before its account is entered; digit-only, validated per bank
  // (CBE legacy lookup uses the last 8, BOA the last 5). The full number is
  // shown to students and matched against the receiver on bank receipts.
  accountNumber String? @unique
  accountName   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── ACADEMIC STRUCTURE ───────────────────────
model Department {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  coverImage  String?
  isArchived  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  academicYears AcademicYear[] // ✅ Fixed: Inverse tracking array added cleanly
  users         User[]
}

model AcademicYear {
  id           String   @id @default(cuid())
  departmentId String
  label        String
  isArchived   Boolean  @default(false)
  createdAt    DateTime @default(now())

  department Department @relation(fields: [departmentId], references: [id])
  semesters  Semester[]
  students   User[]
}

model Semester {
  id             String   @id @default(cuid())
  academicYearId String
  name           String
  isArchived     Boolean  @default(false)
  createdAt      DateTime @default(now())

  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])
  courses      Course[]
}

// ─── COURSES ──────────────────────────────────
model Course {
  id          String   @id @default(cuid())
  semesterId  String
  teacherId   String?
  title       String
  description String?
  coverImage  String?
  isPublished Boolean  @default(false)
  isArchived  Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  semester      Semester       @relation(fields: [semesterId], references: [id])
  teacher       User?          @relation("CourseTeacher", fields: [teacherId], references: [id])
  materials     Material[]
  quizzes       Quiz[]
  announcements Announcement[] // ✅ Explicit relation tracker mapped here
  forumSection  ForumSection?

  @@index([semesterId])
  @@index([teacherId])
}

// ─── MATERIALS ────────────────────────────────
model Material {
  id         String       @id @default(cuid())
  courseId   String
  title      String
  type       MaterialType
  filePath   String?
  youtubeUrl String?
  isSample   Boolean      @default(false)
  sortOrder  Int          @default(0)
  uploadedBy String
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  course          Course           @relation(fields: [courseId], references: [id])
  aiContent       AiContent?
  progressRecords ProgressRecord[]

  @@index([courseId])
}

// ─── AI CONTENT ───────────────────────────────
model AiContent {
  id               String   @id @default(cuid())
  materialId       String   @unique
  status           AiStatus @default(PENDING)
  summary          String?
  keyTopics        Json?
  illustrationPath String?
  error            String? // failure reason when status = FAILED (cleared on success)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  material     Material      @relation(fields: [materialId], references: [id])
  flashcardSet FlashcardSet?
  quizBank     QuizBank?
}

// ─── FLASHCARDS ───────────────────────────────
model FlashcardSet {
  id          String   @id @default(cuid())
  aiContentId String   @unique
  title       String
  createdAt   DateTime @default(now())

  aiContent AiContent         @relation(fields: [aiContentId], references: [id])
  cards     Flashcard[]
  reviews   FlashcardReview[]
}

model Flashcard {
  id             String @id @default(cuid())
  flashcardSetId String
  front          String
  back           String
  sortOrder      Int    @default(0)

  flashcardSet FlashcardSet @relation(fields: [flashcardSetId], references: [id])
}

model FlashcardReview {
  id             String   @id @default(cuid())
  userId         String
  flashcardSetId String
  cardId         String
  isKnown        Boolean
  reviewedAt     DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id])
  flashcardSet FlashcardSet @relation(fields: [flashcardSetId], references: [id])

  @@unique([userId, cardId])
}

// ─── QUIZZES ──────────────────────────────────
model QuizBank {
  id          String   @id @default(cuid())
  aiContentId String   @unique
  createdAt   DateTime @default(now())

  aiContent AiContent  @relation(fields: [aiContentId], references: [id])
  questions Question[]
  // The takeable Quiz anchored to this bank (created lazily on first attempt)
  quiz      Quiz?
}

model Quiz {
  id            String   @id @default(cuid())
  courseId      String
  title         String
  isAiGenerated Boolean  @default(false)
  createdBy     String
  createdAt     DateTime @default(now())
  // Optional link to the AI-generated bank this quiz draws its questions from.
  // Unique so each bank maps to at most one Quiz (the attempt anchor).
  quizBankId    String?  @unique

  course    Course        @relation(fields: [courseId], references: [id])
  quizBank  QuizBank?     @relation(fields: [quizBankId], references: [id])
  questions Question[]
  attempts  QuizAttempt[]
}

model Question {
  id            String  @id @default(cuid())
  quizId        String?
  quizBankId    String?
  text          String
  options       Json
  correctOption String
  explanation   String?
  sortOrder     Int     @default(0)

  quiz     Quiz?        @relation(fields: [quizId], references: [id])
  quizBank QuizBank?    @relation(fields: [quizBankId], references: [id])
  answers  QuizAnswer[]

  @@index([quizBankId])
  @@index([quizId])
}

model QuizAttempt {
  id          String   @id @default(cuid())
  userId      String
  quizId      String
  score       Float
  totalQ      Int
  timeTaken   Int
  completedAt DateTime @default(now())

  user    User         @relation(fields: [userId], references: [id])
  quiz    Quiz         @relation(fields: [quizId], references: [id])
  answers QuizAnswer[]

  @@index([userId])
  @@index([quizId])
}

model QuizAnswer {
  id         String  @id @default(cuid())
  attemptId  String
  questionId String
  selected   String
  isCorrect  Boolean

  attempt  QuizAttempt @relation(fields: [attemptId], references: [id])
  question Question    @relation(fields: [questionId], references: [id])

  @@index([attemptId])
  @@index([questionId])
}

// ─── AI TUTOR HISTORY ─────────────────────────
model AiHistory {
  id         String   @id @default(cuid())
  userId     String
  courseId   String?
  materialId String?
  prompt     String
  response   String
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

// ─── FORUM ────────────────────────────────────
model ForumSection {
  id       String  @id @default(cuid())
  courseId String? @unique
  type     String

  course Course?     @relation(fields: [courseId], references: [id])
  posts  ForumPost[]
}

model ForumPost {
  id        String   @id @default(cuid())
  sectionId String
  authorId  String
  title     String
  content   String
  isPinned  Boolean  @default(false)
  isRemoved Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  section   ForumSection @relation(fields: [sectionId], references: [id])
  author    User         @relation(fields: [authorId], references: [id])
  replies   ForumReply[]
  reactions Reaction[]
  reports   Report[]

  @@index([sectionId])
  @@index([authorId])
}

model ForumReply {
  id        String   @id @default(cuid())
  postId    String
  authorId  String
  content   String
  isRemoved Boolean  @default(false)
  createdAt DateTime @default(now())

  post      ForumPost  @relation(fields: [postId], references: [id])
  author    User       @relation(fields: [authorId], references: [id])
  reactions Reaction[]
  reports   Report[]

  @@index([postId])
  @@index([authorId])
}

// ─── NOTIFICATIONS ────────────────────────────
model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  isRead    Boolean          @default(false)
  meta      Json?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, isRead])
}

// ─── PROGRESS ─────────────────────────────────
model ProgressRecord {
  id         String   @id @default(cuid())
  userId     String
  materialId String
  viewedAt   DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id])
  material Material @relation(fields: [materialId], references: [id])

  @@unique([userId, materialId])
}

// ─── ANNOUNCEMENTS ────────────────────────────
model Announcement {
  id        String   @id @default(cuid())
  courseId  String
  authorId  String
  title     String
  content   String
  createdAt DateTime @default(now())

  course Course @relation(fields: [courseId], references: [id])

  @@index([courseId])
}

// ─── AUDIT LOGS ───────────────────────────────
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String?
  entityId   String?
  meta       Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id])

  @@index([actorId])
  @@index([action])
  @@index([createdAt])
}

// ─── ANATOMY LAB ──────────────────────────────
// A system is a 3D learning module (e.g. heart and circulation). Structure
// content is stored separately so the viewer can load one system at a time and
// so AI prompts can be grounded on the stored text for a single structure.
model AnatomySystem {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  latinName   String?
  description String
  modelUrl    String?
  isSample    Boolean  @default(false)
  isPublished Boolean  @default(true)
  sortOrder   Int      @default(0)
  // Monotonic counter that changes whenever any structure's content changes.
  // Administrator approval records the revision it approved, so an edit
  // automatically makes an older approval stale.
  contentRevision Int   @default(0)
  // Administrative publication approval is separate from faculty sign-off.
  // All three columns are cleared together when content changes or when a
  // sign-off is revoked.
  publicationApprovedAt       DateTime?
  publicationApprovedById     String?
  publicationApprovedRevision Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  structures             AnatomyStructure[]
  publicationApprovedBy  User?            @relation("AnatomySystemPublicationApprover", fields: [publicationApprovedById], references: [id], onDelete: SetNull)

  @@index([isPublished, sortOrder])
  @@index([publicationApprovedById])
}

model AnatomyStructure {
  id            String   @id @default(cuid())
  systemId      String
  slug          String
  name          String
  latinName     String?
  summary       String
  location      String?
  function      String?
  bloodSupply   String?
  clinicalNotes String?
  // Null for text-only structures that have teaching content but no
  // independently selectable mesh in the shipped model.
  meshName      String?
  layer         String?
  // Slugs of related structures within the same system. Stored as slugs so
  // the seed stays readable and the API can resolve names in one pass.
  relatedSlugs  String[] @default([])
  // FMA concepts and textbook citations backing the teaching notes.
  references    String[] @default([])
  sortOrder     Int      @default(0)
  isReviewed    Boolean  @default(false)
  // Set together when a faculty reviewer approves the row. Editing any
  // teaching field clears both and sets isReviewed back to false.
  reviewedAt    DateTime?
  reviewedById  String?
  // The immutable revision row that recorded this sign-off. Linking the
  // approval to a revision proves which exact text was approved.
  reviewedRevisionId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  system    AnatomySystem @relation(fields: [systemId], references: [id], onDelete: Cascade)
  reviewedBy User?        @relation("AnatomyStructureReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedRevision AnatomyStructureRevision? @relation("AnatomyStructureSignOff", fields: [reviewedRevisionId], references: [id], onDelete: SetNull)
  revisions  AnatomyStructureRevision[]

  @@unique([systemId, slug])
  @@unique([systemId, meshName])
  @@index([systemId, sortOrder])
  @@index([reviewedById])
  @@index([reviewedRevisionId])
}

// One row per successful teaching-text save or review-state change. `previous`
// and `new` hold only the editable fields, so a reviewer can compare and
// restore a version without exposing unrelated system metadata. `kind`
// distinguishes content edits from sign-off and invalidation events. Created
// in the same transaction as the structure update.
model AnatomyStructureRevision {
  id          String   @id @default(cuid())
  structureId String
  editorId    String
  createdAt   DateTime @default(now())
  previous    Json
  new         Json
  note        String?
  // 'edit' | 'sign-off' | 'sign-off-invalidated' | 'review-revoked'
  kind        String   @default("edit")

  structure AnatomyStructure @relation(fields: [structureId], references: [id], onDelete: Cascade)
  editor    User              @relation("AnatomyRevisionEditor", fields: [editorId], references: [id], onDelete: Cascade)
  signOffFor AnatomyStructure[] @relation("AnatomyStructureSignOff")

  @@index([structureId, createdAt])
  @@index([editorId])
}

// Singleton row (id = "global") holding lab-wide review policy. A dedicated
// table keeps the setting out of code and lets an administrator toggle it
// without a deploy.
model AnatomyReviewSettings {
  id                   String   @id @default("global")
  requireSecondReviewer Boolean @default(false)
  updatedAt            DateTime @updatedAt
  updatedById          String?
}

// ─── FORUM REACTIONS & REPORTS ────────────────
enum ReactionType {
  LIKE
  LOVE
  TARGET
  FIRE
}

enum ReportReason {
  SPAM
  OFFENSIVE
  OFF_TOPIC
  OTHER
}

enum ReportStatus {
  PENDING
  ACTIONED
  DISMISSED
}

// A user's reaction on a forum post OR reply (exactly one of postId/replyId set)
model Reaction {
  id        String       @id @default(cuid())
  userId    String
  postId    String?
  replyId   String?
  type      ReactionType
  createdAt DateTime     @default(now())

  user  User        @relation(fields: [userId], references: [id])
  post  ForumPost?  @relation(fields: [postId], references: [id])
  reply ForumReply? @relation(fields: [replyId], references: [id])

  // One reaction of a given type per user per post / per reply
  @@unique([userId, postId, type])
  @@unique([userId, replyId, type])
  @@index([postId])
  @@index([replyId])
}

// A report flagging a forum post OR reply for moderation
model Report {
  id         String       @id @default(cuid())
  reporterId String
  postId     String?
  replyId    String?
  reason     ReportReason
  note       String?
  status     ReportStatus @default(PENDING)
  reviewedBy String?
  reviewedAt DateTime?
  createdAt  DateTime     @default(now())

  reporter User        @relation(fields: [reporterId], references: [id])
  post     ForumPost?  @relation(fields: [postId], references: [id])
  reply    ForumReply? @relation(fields: [replyId], references: [id])

  @@index([status])
  @@index([postId])
  @@index([replyId])
  @@index([reporterId])
}
